# Conexión a Postgres (Supabase → Project Settings → Database → Connection string → "Transaction pooler").
# Si la dejas vacía, la app usa una base local (PGlite) en .data/ con datos de ejemplo.
DATABASE_URL=

# URL pública del sitio, sin "/" al final. Se usa en SEO, sitemap, correos y en la API del mod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth y Storage. Sin estas dos, `npm run dev` usa el modo local (cuentas simuladas y archivos en .data/).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Correos que entran como administradores, separados por comas.
ADMIN_EMAILS=

# Secreto para el hash de IP de las descargas (cualquier texto largo y aleatorio).
DOWNLOAD_SALT=
