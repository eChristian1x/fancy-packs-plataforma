# Conexión a Postgres (Supabase → Project Settings → Database → Connection string → "Transaction pooler").
# Si la dejas vacía, la app usa una base local (PGlite) en .data/ con datos de ejemplo.
DATABASE_URL=

# URL pública del sitio, sin "/" al final. Se usa en SEO, sitemap y en la API del mod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (se usan desde la etapa 6: cuentas y subidas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
